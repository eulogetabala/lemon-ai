# ----------------------------
# App config
# ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: your stable public domain (must be HTTPS for Instagram/Threads).
# NEXT_PUBLIC_APP_URL=https://ste-mpservices.site
# Local OAuth testing via a tunnel:
# NEXT_PUBLIC_APP_URL=https://your-ngrok-domain.ngrok-free.app

CHANNEL_OAUTH_STATE_SECRET=9FJb8tJ2rH9WnN7xK5Q1vLMkP6xR2sZcV
CHANNEL_TOKEN_ENCRYPTION_KEY=4xL9nYpQ7sT1vA2uM6dK8wR3mC5hJkZp
INNGEST_DEV=1

# ----------------------------
# Twitter / X OAuth
# ----------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_AUTH_URL=https://x.com/i/oauth2/authorize
TWITTER_TOKEN_URL=https://api.x.com/2/oauth2/token
TWITTER_PROFILE_URL=https://api.x.com/2/users/me?user.fields=profile_image_url,username
TWITTER_SCOPES=tweet.read,users.read,tweet.write,offline.access,media.write

# ----------------------------
# LinkedIn OAuth
# ----------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTH_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_PROFILE_URL=https://api.linkedin.com/v2/userinfo
# For competitor page stats (Marketing API), add:
#   r_organization_social,w_organization_social,r_1st_connections_size
LINKEDIN_SCOPES=openid profile email w_member_social r_organization_social w_organization_social r_1st_connections_size

# ----------------------------
# Instagram OAuth
# ----------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTH_URL=https://api.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_PROFILE_URL=https://graph.instagram.com/me?fields=id,username,account_type,media_count
INSTAGRAM_SCOPES=user_profile,user_media
# LOCAL DEV ONLY. Instagram/Threads require an HTTPS redirect URI (no localhost).
# Point this at a STABLE public tunnel (a cloudflared *named* tunnel with a fixed
# hostname, or an ngrok reserved domain). It is IGNORED in production, where the
# canonical NEXT_PUBLIC_APP_URL is always used instead.
# OAUTH_HTTPS_REDIRECT_URL=https://your-stable-tunnel.example.com

# ----------------------------
# Facebook OAuth
# ----------------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_AUTH_URL=https://www.facebook.com/v19.0/dialog/oauth
FACEBOOK_TOKEN_URL=https://graph.facebook.com/v19.0/oauth/access_token
FACEBOOK_PROFILE_URL=https://graph.facebook.com/v19.0/me?fields=id,name,picture
# Only request scopes that are enabled in Meta App Dashboard
# (Use cases → Manage everything on your Page → Ready for testing).
# After enabling them in Meta, you can add:
#   pages_read_engagement,pages_manage_metadata
# For Instagram Business Discovery later:
#   pages_read_user_content,instagram_basic,instagram_manage_insights,business_management
FACEBOOK_SCOPES=public_profile,pages_show_list,pages_manage_posts

# ----------------------------
# Threads OAuth
# ----------------------------
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_AUTH_URL=https://threads.net/oauth/authorize
THREADS_TOKEN_URL=https://graph.threads.net/oauth/access_token
THREADS_PROFILE_URL=https://graph.threads.net/v1.0/me?fields=id,username,threads_profile_picture_url
THREADS_SCOPES=threads_basic_media,threads_profile_picture,threads_content_publish

# ----------------------------
# Bluesky config
# ----------------------------
BLUESKY_CLIENT_ID=
BLUESKY_CLIENT_SECRET=
BLUESKY_AUTH_URL=https://bsky.social/oauth/authorize
BLUESKY_TOKEN_URL=https://bsky.social/xrpc/com.atproto.server.createSession
BLUESKY_PROFILE_URL=https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile
BLUESKY_SCOPES=

# ----------------------------
# YouTube / Google OAuth
# ----------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
YOUTUBE_TOKEN_URL=https://oauth2.googleapis.com/token
YOUTUBE_PROFILE_URL=https://www.googleapis.com/oauth2/v3/userinfo
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.force-ssl,https://www.googleapis.com/auth/userinfo.profile,email

# ----------------------------
# TikTok OAuth
# ----------------------------
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUTH_URL=https://www.tiktok.com/auth/authorize/
TIKTOK_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_PROFILE_URL=https://open.tiktokapis.com/v2/user/info/
TIKTOK_SCOPES=user.info.basic,video.upload,video.list

# ----------------------------
# Optional / future providers
# ----------------------------
# Add provider-specific credentials here if you extend the project later.

# *****************
# Important:
# 1) Copy this file to .env.local before running the app.
# 2) Fill every secret & client id/secret.
# 3) OAuth flows (Instagram, Facebook, LinkedIn, ...) only work for REAL users
#    once the app is deployed on a stable HTTPS domain. Set NEXT_PUBLIC_APP_URL
#    to https://ste-mpservices.site in production and register
#    `https://ste-mpservices.site/api/channel/callback` in each provider's
#    dashboard (for Meta/Instagram: "Valid OAuth Redirect URIs").
# 4) Do NOT rely on trycloudflare.com / ngrok "quick" URLs in production: they are
#    ephemeral and break as soon as the tunnel restarts.
# *****************
